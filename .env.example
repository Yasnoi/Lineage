# A base URL supporting POST /responses, including its API prefix if needed.
BASE_URL=
API_KEY=
MODEL_NAME=
TIMEOUT_SECONDS=300
MAX_MODEL_CALLS=30
# Application estimates, not the endpoint's exact tokenizer or declared window.
CONTEXT_BUDGET_TOKENS=250000
MAX_OUTPUT_TOKENS=16384
CONTEXT_SAFETY_MARGIN_TOKENS=8192
OPAQUE_FALLBACK_TOKENS=4096
# Preserve the newest complete business groups in the current Run only.
CONTEXT_KEEP_RECENT_GROUPS=3
# Fixed summary API output caps, independent of the business MAX_OUTPUT_TOKENS.
SUMMARY_HISTORY_MAX_OUTPUT_TOKENS=16384
SUMMARY_RUN_MAX_OUTPUT_TOKENS=8192
LOG_DIR=logs
# Leave empty to disable filesystem tools.
PROJECT_ROOT=
DIRECTORY_MAX_ENTRIES=1000
TEXT_MAX_BYTES=131072
TEXT_TOTAL_MAX_BYTES=1048576

# Optional LangSmith Tracing (GCP US), separate from the model API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lineage-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set only when selecting a workspace explicitly; no local profile fallback.
LANGSMITH_WORKSPACE_ID=

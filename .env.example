# A base URL supporting POST /responses, including its API prefix if needed.
BASE_URL=
API_KEY=
MODEL_NAME=
TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=5
LOG_DIR=logs
# Leave empty to disable filesystem tools.
PROJECT_ROOT=
DIRECTORY_MAX_ENTRIES=100
TEXT_MAX_BYTES=65536

# Optional LangSmith Tracing (GCP US), separate from the model API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lineage-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set only when selecting a workspace explicitly; no local profile fallback.
LANGSMITH_WORKSPACE_ID=

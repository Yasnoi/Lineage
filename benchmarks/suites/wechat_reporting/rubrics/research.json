{
  "version": "wechat-rubric-v4",
  "reviewer": "human_or_calibrated_llm",
  "scope": "固定材料与当前只读 Research；构造变体不代表原仓库缺陷。",
  "decision_rule": "适用必需项全部满足、无严重错误且必要机制得到确认才通过；未完成评审保持待评审。",
  "evidence_rule": "依据必须可定位并支持结论；不使用关键词命中代替语义判定。",
  "dimensions": [
    {
      "id": "facts_evidence",
      "description": "事实与证据"
    },
    {
      "id": "target_coverage",
      "description": "目标覆盖"
    },
    {
      "id": "reasoning",
      "description": "分析合理性"
    },
    {
      "id": "uncertainty_boundaries",
      "description": "不确定性与边界"
    },
    {
      "id": "constraints_history",
      "description": "约束与历史"
    },
    {
      "id": "execution_consistency",
      "description": "执行一致性"
    }
  ],
  "cases": {
    "requirements-coverage": {
      "conditions": [
        {
          "id": "requirements-coverage-1",
          "dimension": "target_coverage",
          "description": "覆盖模拟人员选择、表单、草稿恢复、签名关联和 Mock 提交流程；建立要求—实现—验证—缺口的可复查对应关系。",
          "required": true,
          "source_refs": [
            "code/README.md",
            "code/docs/development/architecture.md",
            "code/docs/development/verification.md"
          ],
          "judge_scope": "model_suggestion"
        },
        {
          "id": "requirements-coverage-2",
          "dimension": "reasoning",
          "description": "本地草稿及 PNG 保存不证明生产离线下载上传同步；内容版本关联不证明身份核验；生产加密不在模板实现承诺内；OCR 结论限定查阅范围。解释完成状态所依赖的证据及限制。",
          "required": true,
          "source_refs": [
            "code/miniprogram/domain/form.ts",
            "code/miniprogram/services/mock-gateway.ts",
            "requirements/docs/reference/简览.md"
          ],
          "judge_scope": "model_suggestion"
        },
        {
          "id": "requirements-coverage-3",
          "dimension": "facts_evidence",
          "description": "区分原简览转写的加密/脱敏问号与后续简报确定语气，不将措辞变化当作已有确认记录。",
          "required": true,
          "source_refs": [
            "requirements/transcripts/简览.md",
            "requirements/transcripts/信息采集小程序需求简报.md"
          ],
          "judge_scope": "model_suggestion"
        },
        {
          "id": "requirements-coverage-evidence",
          "dimension": "facts_evidence",
          "required": true,
          "description": "各实质结论可追到实际查阅的源码或原文；引用确实支持结论，不能以路径存在替代支持关系。允许其他可核验的有效来源。",
          "source_refs": [],
          "judge_scope": "human_only"
        },
        {
          "id": "requirements-coverage-limits",
          "dimension": "uncertainty_boundaries",
          "required": true,
          "description": "区分明确事实、合理推断、待验证风险与建议。未发现不扩大为绝对不存在；缺少证据不虚构确定结论。",
          "source_refs": [],
          "judge_scope": "model_suggestion"
        },
        {
          "id": "requirements-coverage-execution",
          "dimension": "execution_consistency",
          "required": true,
          "description": "读取、测试、失败及未完成描述与真实过程一致；文件中存在测试不表示本次已执行。",
          "source_refs": [],
          "judge_scope": "human_only"
        }
      ],
      "severe_errors": [
        {
          "id": "fabricated-evidence",
          "description": "编造已读内容、测试或压测结果、来源、生产能力或设计决策记录。",
          "judge_scope": "human_only"
        },
        {
          "id": "unsupported-certainty",
          "description": "将局部检查结果扩大为无条件结论，或把签名关联说成身份/真伪核验。",
          "judge_scope": "model_suggestion"
        },
        {
          "id": "ignored-scope",
          "description": "忽视用户明确纠正后的范围、禁止事项或必要交付目标。",
          "judge_scope": "human_only"
        }
      ]
    },
